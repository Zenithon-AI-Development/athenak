# AthenaK input file for the FLD/diffusive-operator AMR flux-correction unit test
# (unit_tests/fld_amr_flux_correction_test).
#
# Minimal harness driver: all checks run in ProblemGenerator::UserProblem and the program
# exits before any time integration (nlim = tlim = 0).  A <hydro> block is present only to
# satisfy MeshBlockPack::AddPhysics and to make the static-refinement (SMR) mesh well-tested
# (cf. inputs/tests/linear_wave_hydro_smr.athinput); the FLDGreyOperator is built and
# exercised entirely inside UserProblem on its own radiation-energy array and needs no
# matter initial conditions.
#
# Mesh: 48x48 periodic 2D Cartesian, 16x16 MeshBlocks => 3x3 root blocks.  The single
# INTERIOR root block (region [0.34,0.66]^2) is statically refined to level 1, so the fine
# quadrant is surrounded on all four faces by coarse blocks and NO refinement face touches
# the (periodic) domain edge.  The test verifies the grey FLD operator conserves the
# diffused radiation energy across that refinement boundary to round-off once its face flux
# is registered for the conservative fine->coarse flux correction (#33).

<comment>
problem   = FLD/diffusive-operator AMR flux-correction conservation unit test

<job>
basename  = fld_amr_flux_correction_test   # problem ID: basename of output filenames

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 48         # Number of zones in X1-direction
x1min     = 0.0        # minimum value of X1
x1max     = 1.0        # maximum value of X1
ix1_bc    = periodic   # inner-X1 boundary flag
ox1_bc    = periodic   # outer-X1 boundary flag

nx2       = 48         # Number of zones in X2-direction
x2min     = 0.0        # minimum value of X2
x2max     = 1.0        # maximum value of X2
ix2_bc    = periodic   # inner-X2 boundary flag
ox2_bc    = periodic   # outer-X2 boundary flag

nx3       = 1          # Number of zones in X3-direction
x3min     = -0.5       # minimum value of X3
x3max     = 0.5        # maximum value of X3
ix3_bc    = periodic   # inner-X3 boundary flag
ox3_bc    = periodic   # outer-X3 boundary flag

<meshblock>
nx1       = 16         # Number of cells in each MeshBlock, X1-dir
nx2       = 16         # Number of cells in each MeshBlock, X2-dir
nx3       = 1          # Number of cells in each MeshBlock, X3-dir

<mesh_refinement>
refinement = static    # type of refinement

<refined_region1>
level = 1              # refine the single interior root block to level 1
x1min = 0.34
x1max = 0.66
x2min = 0.34
x2max = 0.66
x3min = -0.5
x3max = 0.5

<time>
evolution            = dynamic   # dynamic/kinematic/static
integrator           = rk2       # hyperbolic time integration algorithm
parabolic_integrator = sts       # operator-split parabolic backend (RKL2 STS)
cfl_number           = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim                 = 0         # cycle limit (0: do no integration, just run UserProblem)
tlim                 = 0         # time limit
ndiag                = 1         # cycles between diagnostic output

<problem>
c_light   = 1.0        # code-unit speed of light
chi       = 1.0        # extinction coefficient (finite => non-trivial fluxes)
n_larsen  = 2.0        # Larsen flux-limiter exponent

<hydro>
eos         = ideal    # EOS type
reconstruct = plm      # spatial reconstruction method
rsolver     = hlle     # Riemann-solver to be used
gamma       = 1.66666666667   # gamma = C_p/C_v
