# AthenaK input file for the static-SMR operator-split anisotropic (Braginskii) conduction
# verification (unit_tests/aniso_conduction_multiblock_test, AMR coarse/fine path).
#
# Same pgen as the uniform multi-block test, run on a STATIC-SMR 2D Cartesian [-1,1]^2 mesh:
# 4x4 root MeshBlocks (mesh 64x64, meshblock 16x16) with the central [-0.5,0.5]^2 region
# refined to level 1.  This surrounds a refined patch with coarse blocks, so the operator's
# per-substage MeshBoundaryValuesCC::SyncParabolicGhosts exercises the coarse/fine
# RestrictCC / FillCoarse / ProlongateCC path, and the conservative pbval_flux_ flux
# correction (#33) carries field-aligned heat across the refinement boundaries.  refinement
# = static so the mesh never regrids (the operator diffuses the live conserved field, which
# is already AMR-regrid-registered as the MHD field, so dynamic regrid needs no new code).
#
# The pgen detects the multilevel mesh and (a) loosens the field-aligned analytic-decay
# tolerance (the c/f prolongation is only O(dx^2)-consistent), (b) skips the no-exchange
# RED discriminator (ill-defined under static refinement), and (c) checks conservation on
# the VOLUME-WEIGHTED energy (fine cells are smaller).  nlim = tlim = 0 (no integration).

<comment>
problem   = static-SMR operator-split anisotropic Braginskii conduction verification

<job>
basename  = aniso_conduction_amr_test   # problem ID: basename of output filenames

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 64         # Number of zones in X1-direction (global, root level)
x1min     = -1.0       # minimum value of X1
x1max     = 1.0        # maximum value of X1
ix1_bc    = outflow    # inner-X1 boundary flag (true insulating domain face)
ox1_bc    = outflow    # outer-X1 boundary flag

nx2       = 64         # Number of zones in X2-direction (global, root level)
x2min     = -1.0       # minimum value of X2
x2max     = 1.0        # maximum value of X2
ix2_bc    = outflow    # inner-X2 boundary flag
ox2_bc    = outflow    # outer-X2 boundary flag

nx3       = 1          # Number of zones in X3-direction
x3min     = -0.5       # minimum value of X3
x3max     = 0.5        # maximum value of X3
ix3_bc    = periodic   # inner-X3 boundary flag
ox3_bc    = periodic   # outer-X3 boundary flag

<meshblock>
nx1       = 16         # 64/16 = 4 root MeshBlocks along X1
nx2       = 16         # 64/16 = 4 root MeshBlocks along X2
nx3       = 1          # Number of cells in each MeshBlock, X3-dir

<mesh_refinement>
refinement = static    # type of refinement (mesh never regrids)

<refined_region1>
level = 1              # refine the central [-0.5,0.5]^2 to level 1
x1min = -0.5
x1max = 0.5
x2min = -0.5
x2max = 0.5
x3min = -0.5
x3max = 0.5

<time>
evolution            = dynamic   # dynamic/kinematic/static
integrator           = rk2       # hyperbolic time integration algorithm
parabolic_integrator = sts       # operator-split parabolic backend (RKL2 STS)
cfl_number           = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim                 = 0         # cycle limit (0: do no integration, just run UserProblem)
tlim                 = 0         # time limit
ndiag                = 1         # cycles between diagnostic output

<hydro>
eos          = ideal   # EOS type
reconstruct  = plm     # spatial reconstruction method
rsolver      = llf     # Riemann-solver to be used
gamma        = 1.66666666666666667   # gamma = C_p/C_v

<problem>
pgen_name = aniso_conduction_multiblock_test  # (ignored: built with -D PROBLEM=unit_tests/...)
