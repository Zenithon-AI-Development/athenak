# AthenaK input file for the AMR (static-SMR) operator-split grey-FLD Marshak verification
# (unit_tests/fld_marshak_multiblock_test, run with this multilevel mesh).
#
# Same optically-thick Marshak wave as fld_marshak_multiblock_test.athinput, but on a 2D
# STATICALLY REFINED mesh: the wave propagates along x1 (uniform in x2) and the interior
# region x1 in [0.1,0.3] is refined to level 1, so the front crosses fine/coarse boundaries
# at x1=0.1 and x1=0.3.  This exercises the restriction/prolongation path of
# MeshBoundaryValuesCC::SyncParabolicGhosts (#108/[A1]) under block-AMR, verifying the grey
# FLD wiring (#110/[A3]) reproduces the analytic erfc Marshak profile across a coarse/fine
# boundary.  Static refinement => the mesh never regrids, so the standalone radiation array
# is never re-mapped (dynamic-regrid array registration for radiation is #111/[A4]).
#
# All checks run in ProblemGenerator::UserProblem; nlim = tlim = 0 (no time integration).

<comment>
problem   = AMR (static-SMR) operator-split grey-FLD Marshak verification

<job>
basename  = fld_marshak_amr_test   # problem ID: basename of output filenames

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 128        # Number of zones in X1-direction (global)
x1min     = 0.0        # minimum value of X1
x1max     = 0.4        # maximum value of X1
ix1_bc    = outflow    # inner-X1 boundary flag (FLD operator overrides ghosts itself)
ox1_bc    = outflow    # outer-X1 boundary flag

nx2       = 32         # Number of zones in X2-direction (uniform-in-x2 wave)
x2min     = 0.0        # minimum value of X2
x2max     = 0.1        # maximum value of X2
ix2_bc    = periodic   # inner-X2 boundary flag
ox2_bc    = periodic   # outer-X2 boundary flag

nx3       = 1          # Number of zones in X3-direction
x3min     = -0.5       # minimum value of X3
x3max     = 0.5        # maximum value of X3
ix3_bc    = periodic   # inner-X3 boundary flag
ox3_bc    = periodic   # outer-X3 boundary flag

<meshblock>
nx1       = 32         # 128/32 = 4 root MeshBlocks along X1
nx2       = 32         # 32/32  = 1 root MeshBlock  along X2
nx3       = 1          # Number of cells in each MeshBlock, X3-dir

<mesh_refinement>
refinement = static    # type of refinement (mesh never regrids)

<refined_region1>
level = 1              # refine the interior x1 in [0.1,0.3] to level 1
x1min = 0.1
x1max = 0.3
x2min = 0.0
x2max = 0.1
x3min = -0.5
x3max = 0.5

<time>
evolution            = dynamic   # dynamic/kinematic/static
integrator           = rk2       # hyperbolic time integration algorithm
parabolic_integrator = sts       # operator-split parabolic backend (RKL2 STS)
cfl_number           = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim                 = 0         # cycle limit (0: do no integration, just run UserProblem)
tlim                 = 0         # time limit
ndiag                = 1         # cycles between diagnostic output

<mhd>
eos                = ideal   # EOS type
reconstruct        = plm     # spatial reconstruction method
rsolver            = hlle    # Riemann-solver to be used
gamma              = 1.66666666666666667   # gamma = C_p/C_v
fld_operator_split = true    # wire grey FLD operator-split into the MHD timestep (#110)
fld_c_light        = 1.0     # code-unit speed of light
fld_chi            = 1.0e3   # extinction coefficient kappa_R*rho [1/length] (optically thick)
fld_n_larsen       = 2.0     # Larsen flux-limiter exponent
fld_e_source       = 1.0     # inner-x1 Dirichlet radiation-energy source (hot wall)

<problem>
e_floor   = 0.1        # initial/cold radiation energy
tlim_fld  = 50.0       # FLD integration time (front ~ 2 sqrt(D*tlim) ~ 0.26 < domain)
n_super   = 20         # number of operator-split RKL2 supersteps
