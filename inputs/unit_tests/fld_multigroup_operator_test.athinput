# AthenaK input file for the multigroup FLD operator unit test
# (unit_tests/fld_multigroup_operator_test).
#
# Minimal harness driver: all checks run in ProblemGenerator::UserProblem and the program
# exits before any time integration (nlim = tlim = 0).  A single physics block is required
# by MeshBlockPack::AddPhysics; we use a tiny <z4c> setup (matching the other unit tests)
# because the FLDMultigroupOperator is built and exercised entirely inside UserProblem on
# its own per-group radiation-energy array and needs no matter initial conditions.
#
# The test reads the optically-thick multigroup-opacity fixture (group structure + per-group
# Rosseland transport opacity), then verifies the per-group operator action reproduces the
# discrete diffusion eigenvalue with D_g = c/(3 chi_g).  <problem>/opacity_file defaults to a
# repo-relative path; the auto-collected Python wrapper overrides it with an absolute path
# (problem/opacity_file=<abspath>) since the test runs from tst/build*/src.

<comment>
problem   = multigroup FLD operator (per-group Larsen limiter, per-group Rosseland D) test

<job>
basename  = fld_multigroup_operator_test   # problem ID: basename of output filenames

<problem>
opacity_file = inputs/radiation_fld/multigroup_opacity.cn4   # multigroup opacity fixture
c_light   = 1.0        # code-unit speed of light
n_larsen  = 2.0        # Larsen flux-limiter exponent
rho_bg    = 1.0e-2     # uniform background mass density (fixture reference node)
te_bg     = 1.0e2      # uniform background electron temperature (fixture reference node)
# ----- per-group free-streaming super-step positivity (issue #197) knobs -----
chi_thin_mg  = 8.0     # transition-regime per-group extinction (RKL2-unstable band)
esrc_thin_mg = -1.0    # insulated box (esrc<0): let the seeded checkerboard evolve freely
e_bg_mg      = 1.0     # background radiation energy (O(1) so R sits in transition band)
seed_amp_mg  = 0.5     # checkerboard seed amplitude (the most-amplified mode)
dt_fac_mg    = 2.0e3   # super-step over explicit limit (large ratio => RKL2 over-steps)
nstep_mg     = 1.5e2   # number of RKL2 super-steps in the sustained drive
mgfld_efloor = 1.0e-10 # per-group erad positivity floor (#197): projection level
# ----- per-group monotone-front streaming runaway (issue #215 <- #194) knobs -----
chi_front_mg    = 8.0     # front extinction (transition/streaming band, R~4-8)
esrc_front_mg   = 1.0     # HOT inner-x1 Dirichlet wall sustaining the front
e_hi_mg         = 1.0     # bright (inner) side of the monotone front
e_lo_mg         = 1.0e-6  # cold (outer) side; re-imposed each step to hold the front sharp
dt_fac_front_mg = 5000.0  # super-step over the explicit limit
nstep_front_mg  = 300.0   # number of RKL2 super-steps in the sustained drive
chi_dt_mg       = 1.0     # (D2) extinction for the period-4 square-wave dt probe

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 64         # Number of zones in X1-direction
x1min     = 0.0        # minimum value of X1
x1max     = 1.0        # maximum value of X1
ix1_bc    = outflow    # inner-X1 boundary flag
ox1_bc    = outflow    # outer-X1 boundary flag

nx2       = 1          # Number of zones in X2-direction
x2min     = -0.5       # minimum value of X2
x2max     = 0.5        # maximum value of X2
ix2_bc    = periodic   # inner-X2 boundary flag
ox2_bc    = periodic   # outer-X2 boundary flag

nx3       = 1          # Number of zones in X3-direction
x3min     = -0.5       # minimum value of X3
x3max     = 0.5        # maximum value of X3
ix3_bc    = periodic   # inner-X3 boundary flag
ox3_bc    = periodic   # outer-X3 boundary flag

<meshblock>
nx1       = 64         # Number of cells in each MeshBlock, X1-dir
nx2       = 1          # Number of cells in each MeshBlock, X2-dir
nx3       = 1          # Number of cells in each MeshBlock, X3-dir

<time>
evolution            = dynamic   # dynamic/kinematic/static
integrator           = rk2       # hyperbolic time integration algorithm
parabolic_integrator = sts       # operator-split parabolic backend (RKL2 STS)
cfl_number           = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim                 = 0         # cycle limit (0: do no integration, just run UserProblem)
tlim                 = 0         # time limit
ndiag                = 1         # cycles between diagnostic output

<z4c>
