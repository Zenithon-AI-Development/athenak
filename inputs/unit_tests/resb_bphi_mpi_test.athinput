# AthenaK input file for the multi-RANK (MPI) operator-split CYLINDRICAL resistive B_phi
# diffusion verification (unit_tests/resb_bphi_multiblock_test, cross-rank exchange).
#
# Same pgen as the full-disk multi-block test, but run on a radial ANNULUS r in [r0, R=1]
# decomposed into FOUR radial MeshBlocks (mesh nx1=128, meshblock nx1=32) -- one per rank
# under mpirun -np 4, so every internal radial block face is a cross-RANK MPI ghost
# exchange.  The annulus uses the Bessel J_1(kr*r) eigenmode with kr = j_{1,2}/R and
# r0 = j_{1,1}/kr, so J_1 vanishes at BOTH annulus ends (J_1(j_{1,1})=J_1(j_{1,2})=0) and the
# operator's antisymmetric/Dirichlet-0 ghost is exact at the true radial domain faces.
#
# WHY AN ANNULUS (NOT THE FULL DISK) FOR MPI: the operator's explicit-stable dt is currently
# reduced PER RANK (the global min-dt reduction is #114/[B1], not yet implemented).  On the
# full disk the near-axis -eta B_phi/r^2 term makes the axis block's dt far smaller than the
# outer blocks' -> different ranks would pick different RKL2 stage counts -> the synchronous
# cross-rank SyncParabolicGhosts would deadlock.  The annulus excludes the axis, so the
# radial diffusion 2 eta/dx^2 dominates and the per-rank dt is uniform to ~0.005% -> every
# rank uses the SAME stage count.  The -eta B_phi/r^2 curl-curl term is still verified through
# the J_1 SHAPE preservation; the near-axis 1/r^2 stiffness is covered by the _cpu / _amr
# full-disk meshes (single rank).  nlim = tlim = 0 (no time integration).

<comment>
problem   = multi-rank (MPI) operator-split cylindrical resistive B_phi diffusion verification

<job>
basename  = resb_bphi_mpi_test   # problem ID: basename of output filenames

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 128        # Number of radial zones (global)
x1min     = 0.54617042 # r0 = j_{1,1}/j_{1,2} * R (inner J_1 node, excludes the axis)
x1max     = 1.0        # r_max (the J_1 outer node, J_1(j_{1,2})=0)
ix1_bc    = outflow    # inner radial boundary (operator overrides with antisym/Dirichlet)
ox1_bc    = outflow    # outer radial boundary (operator overrides with antisym/Dirichlet)

nx2       = 1          # azimuthal (phi) zones (1 -> axisymmetric)
x2min     = -0.5       # phi_min
x2max     = 0.5        # phi_max
ix2_bc    = periodic   # phi boundary
ox2_bc    = periodic   # phi boundary

nx3       = 1          # axial (z) zones
x3min     = -0.5       # z_min
x3max     = 0.5        # z_max
ix3_bc    = periodic   # z boundary
ox3_bc    = periodic   # z boundary

<coord>
system    = cylindrical  # (x1,x2,x3) = (r,phi,z)

<meshblock>
nx1       = 32         # 128/32 = 4 annular MeshBlocks along the radius (one per rank)
nx2       = 1          # cells per MeshBlock, X2-dir
nx3       = 1          # cells per MeshBlock, X3-dir

<time>
evolution            = dynamic   # dynamic/kinematic/static
integrator           = rk2       # hyperbolic time integration algorithm
parabolic_integrator = sts       # operator-split parabolic backend (RKL2 STS)
cfl_number           = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim                 = 0         # cycle limit (0: do no integration, just run UserProblem)
tlim                 = 0         # time limit
ndiag                = 1         # cycles between diagnostic output

<hydro>
eos          = ideal   # EOS type
reconstruct  = plm     # spatial reconstruction method
rsolver      = hllc    # Riemann-solver to be used
gamma        = 1.66666666666666667   # gamma = C_p/C_v

<problem>
pgen_name = resb_bphi_multiblock_test  # (ignored: built with -D PROBLEM=unit_tests/...)
eta     = 0.01         # constant magnetic diffusivity (constant fill)
amp     = 1.0          # B_phi eigenmode amplitude
kr      = 7.0155866698156188   # radial wavenumber = j_{1,2}/R (J_1 zeros at both ends)
n_super = 11           # number of RKL2 supersteps
dt_fac  = 200.0        # superstep size in units of the explicit-stable dt
