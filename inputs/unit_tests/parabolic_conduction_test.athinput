# AthenaK input file for the operator-split conduction unit test
# (unit_tests/parabolic_conduction_test).
#
# Minimal harness driver: all checks run in ProblemGenerator::UserProblem and the program
# exits (nlim = tlim = 0) before any time integration.  Unlike the other unit tests this
# one needs a REAL hydro block with thermal conduction (<hydro> conductivity), because it
# re-expresses AthenaK's existing isotropic conduction as a parabolic::ParabolicOperator
# (ConductionOperator) and advances it operator-split by the RKL2 STS integrator over the
# hydro conserved field.  The 1D static, uniform-density medium gives the analytic cosine
# diffusion eigenmode the test checks against.
#
# <time> parabolic_integrator = sts selects the RKL2 super-time-stepping backend (ADR-0001).

<comment>
problem   = operator-split conduction (ConductionOperator + RKL2 STS) unit test

<job>
basename  = parabolic_conduction_test   # problem ID: basename of output filenames

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 64         # Number of zones in X1-direction
x1min     = 0.0        # minimum value of X1
x1max     = 1.0        # maximum value of X1
ix1_bc    = outflow    # inner-X1 boundary flag
ox1_bc    = outflow    # outer-X1 boundary flag

nx2       = 1          # Number of zones in X2-direction
x2min     = -0.5       # minimum value of X2
x2max     = 0.5        # maximum value of X2
ix2_bc    = periodic   # inner-X2 boundary flag
ox2_bc    = periodic   # outer-X2 boundary flag

nx3       = 1          # Number of zones in X3-direction
x3min     = -0.5       # minimum value of X3
x3max     = 0.5        # maximum value of X3
ix3_bc    = periodic   # inner-X3 boundary flag
ox3_bc    = periodic   # outer-X3 boundary flag

<meshblock>
nx1       = 64         # Number of cells in each MeshBlock, X1-dir
nx2       = 1          # Number of cells in each MeshBlock, X2-dir
nx3       = 1          # Number of cells in each MeshBlock, X3-dir

<time>
evolution            = dynamic   # dynamic/kinematic/static
integrator           = rk2       # hyperbolic time integration algorithm
parabolic_integrator = sts       # operator-split parabolic backend (RKL2 STS)
cfl_number           = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim                 = 0         # cycle limit (0: do no integration, just run UserProblem)
tlim                 = 0         # time limit
ndiag                = 1         # cycles between diagnostic output

<hydro>
eos          = ideal   # EOS type
reconstruct  = plm     # spatial reconstruction method
rsolver      = llf     # Riemann-solver to be used
gamma        = 1.66666666666666667   # gamma = C_p/C_v
conductivity = 1.0     # isotropic thermal conductivity (enables Conduction)

<problem>
pgen_name = parabolic_conduction_test  # (ignored: built with -D PROBLEM=unit_tests/...)
