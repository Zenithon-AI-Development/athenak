# AthenaK input file for the cn4 EOS dimensional-anchor unit test (#209/#210)
# (unit_tests/ionmix_cn4_units_test).
#
# Minimal harness driver: all checks run in ProblemGenerator::UserProblem and the program
# exits before any time integration (nlim = tlim = 0).  A single physics block is required
# by MeshBlockPack::AddPhysics; we use a tiny <z4c> setup (matching the other unit tests)
# because the opacity reader + representation is built and exercised entirely inside
# UserProblem and needs no matter initial conditions, no field EOS, and no mesh data.
#
# <problem>/opacity_file is the path to the IONMIX-style fixture table.  The default below
# is repo-relative; the auto-collected Python wrapper overrides it on the command line with
# an absolute path (problem/opacity_file=<abspath>) since the test runs from tst/build*/src.

<comment>
problem   = cn4 EOS dimensional-anchor unit test (#209/#210)

<job>
basename  = ionmix_cn4_units_test   # problem ID: basename of output filenames

<problem>
eos_table        = inputs/ionmix/al-imx-004.cn4   # real aluminum IONMIX cn4 (abs path via wrapper)
eos_mass_per_ion = 4.4804e-23                     # Al ion mass [g]

<units>
length_cgs   = 0.1      # B1 deck units: 1 code length = 1 mm
density_cgs  = 2.7      # 1 code density = solid aluminum
velocity_cgs = 1.0e8    # 1 code time = 1 ns

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 8          # Number of zones in X1-direction
x1min     = -1.0       # minimum value of X1
x1max     = 1.0        # maximum value of X1
ix1_bc    = outflow    # inner-X1 boundary flag
ox1_bc    = outflow    # outer-X1 boundary flag

nx2       = 8          # Number of zones in X2-direction
x2min     = -1.0       # minimum value of X2
x2max     = 1.0        # maximum value of X2
ix2_bc    = outflow    # inner-X2 boundary flag
ox2_bc    = outflow    # outer-X2 boundary flag

nx3       = 8          # Number of zones in X3-direction
x3min     = -1.0       # minimum value of X3
x3max     = 1.0        # maximum value of X3
ix3_bc    = outflow    # inner-X3 boundary flag
ox3_bc    = outflow    # outer-X3 boundary flag

<meshblock>
nx1       = 8          # Number of cells in each MeshBlock, X1-dir
nx2       = 8          # Number of cells in each MeshBlock, X2-dir
nx3       = 8          # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = dynamic   # dynamic/kinematic/static
integrator = rk3       # time integration algorithm
cfl_number = 0.1       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 0         # cycle limit (0: do no integration, just run UserProblem)
tlim       = 0         # time limit
ndiag      = 1         # cycles between diagnostic output

<z4c>
