# AthenaK input file for the multi-block operator-split conduction verification
# (unit_tests/conduction_multiblock_test).
#
# A 1D static, uniform-density medium carrying the global discrete cosine diffusion
# eigenmode, decomposed into FOUR MeshBlocks along x1 (mesh nx1=64, meshblock nx1=16).  The
# isotropic ConductionOperator is advanced operator-split by the RKL2 STS integrator; its
# per-substage ghost refresh delegates the cross-block (and, under MPI, cross-rank) neighbor
# exchange to MeshBoundaryValuesCC::SyncParabolicGhosts (#108/[A1]).  The test asserts the
# global mode reproduces the analytic exp(lambda t) decay across the block boundaries.
#
# All checks run in ProblemGenerator::UserProblem; nlim = tlim = 0 (no time integration).
# x1 boundaries are outflow (NON-periodic) so the global domain ends are insulated (no
# wrap-around neighbor) while the three internal block faces exchange neighbor data.

<comment>
problem   = multi-block operator-split conduction (SyncParabolicGhosts) verification

<job>
basename  = conduction_multiblock_test   # problem ID: basename of output filenames

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 64         # Number of zones in X1-direction (global)
x1min     = 0.0        # minimum value of X1
x1max     = 1.0        # maximum value of X1
ix1_bc    = outflow    # inner-X1 boundary flag (non-periodic => insulated domain end)
ox1_bc    = outflow    # outer-X1 boundary flag (non-periodic => insulated domain end)

nx2       = 1          # Number of zones in X2-direction
x2min     = -0.5       # minimum value of X2
x2max     = 0.5        # maximum value of X2
ix2_bc    = periodic   # inner-X2 boundary flag
ox2_bc    = periodic   # outer-X2 boundary flag

nx3       = 1          # Number of zones in X3-direction
x3min     = -0.5       # minimum value of X3
x3max     = 0.5        # maximum value of X3
ix3_bc    = periodic   # inner-X3 boundary flag
ox3_bc    = periodic   # outer-X3 boundary flag

<meshblock>
nx1       = 16         # 64/16 = 4 MeshBlocks along X1 (the multi-block decomposition)
nx2       = 1          # Number of cells in each MeshBlock, X2-dir
nx3       = 1          # Number of cells in each MeshBlock, X3-dir

<time>
evolution            = dynamic   # dynamic/kinematic/static
integrator           = rk2       # hyperbolic time integration algorithm
parabolic_integrator = sts       # operator-split parabolic backend (RKL2 STS)
cfl_number           = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim                 = 0         # cycle limit (0: do no integration, just run UserProblem)
tlim                 = 0         # time limit
ndiag                = 1         # cycles between diagnostic output

<hydro>
eos                       = ideal   # EOS type
reconstruct               = plm     # spatial reconstruction method
rsolver                   = llf     # Riemann-solver to be used
gamma                     = 1.66666666666666667   # gamma = C_p/C_v
conductivity              = 1.0     # isotropic thermal conductivity (enables Conduction)
conduction_operator_split = true    # advance conduction operator-split (RKL2 STS), #13/#108

<problem>
pgen_name = conduction_multiblock_test  # (ignored: built with -D PROBLEM=unit_tests/...)
