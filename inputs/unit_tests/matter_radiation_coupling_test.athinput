# AthenaK input file for the point-implicit grey matter-radiation coupling unit test
# (unit_tests/matter_radiation_coupling_test).
#
# Minimal harness driver: all checks run in ProblemGenerator::UserProblem and the program
# exits before any time integration (nlim = tlim = 0).  A single physics block is required
# by MeshBlockPack::AddPhysics; we use a tiny <z4c> setup (matching the other unit tests)
# because the coupling is a pure per-cell device function exercised entirely inside
# UserProblem on its own scratch arrays and needs no matter initial conditions or EOS.
#
# The test verifies the per-cell backward-Euler matter-radiation exchange
# (radiationfld::PointImplicitGreyCoupling): relaxation to radiative equilibrium, exact
# energy conservation, no spatial dependence, and unconditional stability for stiff
# absorption (issue [8b]/#23, ADR-0001/0002).

<comment>
problem   = point-implicit grey matter-radiation coupling unit test

<job>
basename  = matter_radiation_coupling_test   # problem ID: basename of output filenames

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 16         # Number of zones in X1-direction
x1min     = 0.0        # minimum value of X1
x1max     = 1.0        # maximum value of X1
ix1_bc    = outflow    # inner-X1 boundary flag
ox1_bc    = outflow    # outer-X1 boundary flag

nx2       = 1          # Number of zones in X2-direction
x2min     = -0.5       # minimum value of X2
x2max     = 0.5        # maximum value of X2
ix2_bc    = periodic   # inner-X2 boundary flag
ox2_bc    = periodic   # outer-X2 boundary flag

nx3       = 1          # Number of zones in X3-direction
x3min     = -0.5       # minimum value of X3
x3max     = 0.5        # maximum value of X3
ix3_bc    = periodic   # inner-X3 boundary flag
ox3_bc    = periodic   # outer-X3 boundary flag

<meshblock>
nx1       = 16         # Number of cells in each MeshBlock, X1-dir
nx2       = 1          # Number of cells in each MeshBlock, X2-dir
nx3       = 1          # Number of cells in each MeshBlock, X3-dir

<time>
evolution            = dynamic   # dynamic/kinematic/static
integrator           = rk2       # hyperbolic time integration algorithm
cfl_number           = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim                 = 0         # cycle limit (0: do no integration, just run UserProblem)
tlim                 = 0         # time limit
ndiag                = 1         # cycles between diagnostic output

<problem>

<z4c>
