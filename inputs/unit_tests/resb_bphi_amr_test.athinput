# AthenaK input file for the static-SMR operator-split CYLINDRICAL resistive B_phi
# diffusion verification (unit_tests/resb_bphi_multiblock_test, AMR coarse/fine path).
#
# Same pgen + same full-disk J_1(kr*r) eigenmode (kr = j_{1,1}/R) as the uniform multi-block
# test, run on a STATIC-SMR 1-D radial cylinder r in [0,1]: 8 root MeshBlocks (mesh nx1=128,
# meshblock nx1=16) with the mid-radius band r in [0.25,0.625] refined to level 1.  This
# surrounds a refined radial patch with coarse blocks, so the operator's per-substage
# MeshBoundaryValuesCC::SyncParabolicGhosts exercises the coarse/fine RestrictCC / FillCoarse
# / ProlongateCC path, and the conservative pbval_flux_ flux correction (#33) carries the
# diffused B_phi (the area-weighted poloidal flux) across the refinement boundaries.  The c/f
# faces (r=0.25, r=0.625) sit in smooth regions of J_1 (away from the axis singularity).
# refinement = static so the mesh never regrids.
#
# The pgen detects the multilevel mesh and loosens the analytic-decay / shape / rate
# tolerances (the c/f prolongation is only O(dx^2)-consistent) and skips the no-exchange RED
# discriminator (ill-defined under static refinement).  Single rank, so the per-block
# explicit dt is reduced globally on the rank -> one RKL2 stage count (no MPI deadlock risk).
# nlim = tlim = 0 (no time integration).

<comment>
problem   = static-SMR operator-split cylindrical resistive B_phi diffusion verification

<job>
basename  = resb_bphi_amr_test   # problem ID: basename of output filenames

<mesh>
nghost    = 2          # Number of ghost cells
nx1       = 128        # Number of radial zones (global, root level)
x1min     = 0.0        # r_min (the axis)
x1max     = 1.0        # r_max (the J_1 outer node)
ix1_bc    = axis       # r=0 axisymmetric boundary (operator overrides with antisym ghost)
ox1_bc    = outflow    # outer radial boundary (operator overrides with antisym/Dirichlet)

nx2       = 1          # azimuthal (phi) zones (1 -> axisymmetric)
x2min     = -0.5       # phi_min
x2max     = 0.5        # phi_max
ix2_bc    = periodic   # phi boundary
ox2_bc    = periodic   # phi boundary

nx3       = 1          # axial (z) zones
x3min     = -0.5       # z_min
x3max     = 0.5        # z_max
ix3_bc    = periodic   # z boundary
ox3_bc    = periodic   # z boundary

<coord>
system    = cylindrical  # (x1,x2,x3) = (r,phi,z)

<meshblock>
nx1       = 16         # 128/16 = 8 root MeshBlocks along the radius
nx2       = 1          # cells per MeshBlock, X2-dir
nx3       = 1          # cells per MeshBlock, X3-dir

<mesh_refinement>
refinement = static    # type of refinement (mesh never regrids)

<refined_region1>
level = 1              # refine the mid-radius band r in [0.25,0.625] to level 1
x1min = 0.25
x1max = 0.625
x2min = -0.5
x2max = 0.5
x3min = -0.5
x3max = 0.5

<time>
evolution            = dynamic   # dynamic/kinematic/static
integrator           = rk2       # hyperbolic time integration algorithm
parabolic_integrator = sts       # operator-split parabolic backend (RKL2 STS)
cfl_number           = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim                 = 0         # cycle limit (0: do no integration, just run UserProblem)
tlim                 = 0         # time limit
ndiag                = 1         # cycles between diagnostic output

<hydro>
eos          = ideal   # EOS type
reconstruct  = plm     # spatial reconstruction method
rsolver      = hllc    # Riemann-solver to be used
gamma        = 1.66666666666666667   # gamma = C_p/C_v

<problem>
pgen_name = resb_bphi_multiblock_test  # (ignored: built with -D PROBLEM=unit_tests/...)
eta     = 0.01         # constant magnetic diffusivity (constant fill)
amp     = 1.0          # B_phi eigenmode amplitude
kr      = 3.8317059702075123   # radial wavenumber = j_{1,1}/R (J_1 zero on axis + outer node)
n_super = 24           # number of RKL2 supersteps
dt_fac  = 200.0        # superstep size in units of the explicit-stable dt
