# AthenaK input: FAITHFUL single-mode magneto-Rayleigh-Taylor on an aluminum liner --
# Ellison benchmark 1 / [C3] (issue #120), the QUANTITATIVE GPU replication target.
#
# This REPLACES the idealized code-unit surrogate (maglif_mrt.athinput / #142): every knob
# here is a faithful, dimensional value, mirroring the faithful Ellison B2 setup
# (maglif_b2_ellison.athinput / #163) but for the SINGLE-MODE, initially-solid-aluminum
# Sinars 2010/2011 experiment (Phys. Rev. Lett. 105, 185001; Phys. Plasmas 18, 056301):
#   * a representative AR6 aluminum liner (r_in 2.8875 / r_out 3.4688 mm) -- the #160/[P3]
#     dimensional geometry, with solid-Al density 2.7 g/cc as the code density unit;
#   * the REAL measured z2173 Z-machine load current -- the #160/[P3] tabulated drive
#     (peak about 20 MA at about 100 ns; the Sinars and z2173 shots share the Z driver);
#   * a SINGLE seeded axial sinusoid at lambda 400 um (within the published 25 to 400 um
#     Sinars seeding range), seed amplitude 20 um (the Sinars initial radiographic
#     amplitude, matching the first committed Sinars datum point 0.0197 mm);
#   * 12.5 um finest cell (uniform), radiation OFF (ideal-MHD core only).
#
# VALIDATION TIER (#120 [C3]): QUANTITATIVE.  The seeded single-mode amplitude-growth
# history is compared against the digitized Sinars-2011 experimental growth curve
# (committed in verification/ground_truth/b1_single_mode_mrt_sinars_2011.json, now
# status digitized via #154) through the curve oracle (ADR-0008).  The GPU benchmark
# (test_verify_maglif_b1_sinars_gpu.py) reports that comparison in the scorecard.
#
# FAITHFUL DIMENSIONAL SETUP (#174/[P5], ADR-0010): the IONMIX tabulated 3T EOS is now wired
# into BOTH the LLF solver (#162) AND this multi-material maglif IC (the `else` tabulated IC
# branch fills the conserved energy + the e_ele scalar from the code-unit-scaled Al table),
# and the z2173 load trace is consumed in faithful SI units -- time [ns] -> code time and
# current [MA] -> code current via the calibration validated by the closed-form
# magnetic-pressure anchor (~5 Mbar at 20 MA / 3.47 mm; test_unit_maglif_si_calibration_cpu).
# velocity_cgs is conditioned so 1 code time = 1 ns, so the amplitude(t) curve is compared
# against Sinars on ABSOLUTE time (the time axis gates implosion timing, the magnitude gates
# growth).  Below-table-floor densities (vacuum gap, low-density fill) are edge-clamped by the
# table inversion (no out-of-range access), so the multi-material target is well-posed.
#
# HONEST SCOPE NOTE (the engineering residual to a binding quantitative MATCH):
#   The growth-factor MATCH may still fall short of the experiment's multi-e-folding growth.
#   Per ADR-0011 (attribution policy) the residual is NOT attributable to material strength:
#   the Ellison/FLASH reference (arXiv:2504.10760) matched B1 with a STRENGTHLESS hydrodynamic
#   liner, so strength is not a permissible explanation.  Any surviving shortfall -- after the
#   magnetic-pressure anchor (calibration), implosion timing (bulk dynamics) and the
#   1D-stays-1D + coarse two-grid convergence (numerics) are cleared -- is bounded by the
#   reference's model set (conduction / resistivity / gray radiation diffusion) and filed as a
#   follow-up with that evidence.  The amplitude(t) comparison is therefore still REPORTED
#   (binding False) here, with the binding gate the qualitative single-mode MRT signature.
#
# RESOLUTION NOTE (as maglif_b2_ellison.athinput): AthenaK has no 3-D cylindrical SMR/AMR
# (only the 2-D (r,phi) Balsara prolongation, #38), and the seed is AXIAL, so z must be
# resolved -> a 3-D (r,phi,z) mesh and "12.5 um finest" is a UNIFORM fine grid: nx1 288 over
# [0, 3.6] mm (dr 12.5 um) x nx3 128 over [0, 1.6] mm (dz 12.5 um; lambda 400 um -> 32
# cells/wavelength, 4 wavelengths in the box).  ADR-0004 fixes the axial direction to x3
# (AthenaK forbids nx2 1 with nx3 > 1), so a thin azimuthal (phi) wedge carries the
# axisymmetric IC; the seeded sinusoid breaks the axisymmetry along z.
#
# IMPORTANT (bin-header reader gotcha): vis/python/bin_convert splits embedded header lines
# on the equals sign with no maxsplit, so an inline comment or value containing an equals
# sign crashes the reader.  The embedded header carries the <comment> text line and every
# param line WITH its inline comment, so those MUST avoid the equals sign (this rich top
# block of full-line comments is NOT embedded and may use it freely).
#
# Built with -D PROBLEM=maglif (a USER pgen).  A run resolves problem/current_file to the
# committed trace (here a repo-relative path; a runner launching from another directory
# should override it with the absolute path).  The reduced-resolution check that exercises
# this exact physical setup at low cost on CPU is the same test's reduced-grid override;
# the GPU paper-resolution gate is test_verify_maglif_b1_sinars_gpu.py.

<comment>
problem   = Ellison B1 faithful single-mode MRT, AR6 Al liner, z2173 drive, lambda 400 um seed

<job>
basename  = maglif_b1_sinars

<units>
length_cgs   = 0.1        # cm per code length, so code length unit is 1 mm
density_cgs  = 2.7        # g/cc per code density, so code density unit is solid aluminum
velocity_cgs = 1.0e8      # cm/s per code velocity, conditioned so 1 code time is 1 ns (ADR-0010)

<mesh>
nghost    = 2
nx1       = 288       # radial zones (uniform) over [0, 3.6] mm, dr 12.5 um (finest)
x1min     = 0.0       # r 0 axis
x1max     = 3.6       # outer radius R_out 3.6 mm (driven boundary; beyond r_out 3.4688)
ix1_bc    = axis      # cylindrical r 0 axisymmetric boundary (issue #16)
ox1_bc    = user      # circuit-driven B_phi outer boundary (issue #21)

nx2       = 4         # thin azimuthal (phi) wedge (axisymmetric IC; seed breaks it along z)
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 128       # axial (z) zones over [0, 1.6] mm, dz 12.5 um (finest)
x3min     = 0.0
x3max     = 1.6       # axial domain 1.6 mm (4 seeded wavelengths of 400 um)
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 144       # 2 root MeshBlocks along r
nx2       = 4
nx3       = 64        # 2 root MeshBlocks along z (4 blocks total)

<coord>
system    = cylindrical  # (x1,x2,x3) are (r,phi,z)

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 800000
tlim       = 130.0       # code time (ns, SI-calibrated); run-in to peak current (about 100 ns)
dt_max     = 0.5         # ns ceiling: step through the field-free cold start before drive ramps (#174)
ndiag      = 1000

<mhd>
eos              = tabulated_3t                    # faithful IONMIX 3T EOS (#174); radiation OFF
eos_table        = inputs/ionmix/al-imx-004.cn4    # FLASH aluminum IONMIX cn4 (overridden by test)
eos_mass_per_ion = 4.4804e-23                      # Al ion mass [g] -> number-density axis to g/cc
nscalars         = 1                               # passive scalar 0 carries e_ele/rho (ADR-0002)
reconstruct      = plm
rsolver          = llf                             # required for tabulated_3t: routes p_gas(rho,e) (#162)
gamma            = 1.6666666666666667              # ideal-gamma wave-speed bookkeeping only (#162)
dfloor           = 1.0e-5
pfloor           = 1.0e-7
# ---- reference-model-set operators (ADR-0011 candidate set), all OFF in the faithful
#      baseline (byte-identical: *_operator_split false maps to GetOrAdd default).  Present
#      so the per-operator attribution test (test_verify_maglif_b1_operators_gpu.py) can flip
#      each ON one at a time by CLI override (overrides only REPLACE existing params).  Per
#      ADR-0012 gaps: resb is now COUPLED to the live driven b0.x2f (#181/[P7a],
#      resb_couple_b0 below) so resistivity is ACTIVE; the FLD erad is now SOURCED from the
#      gas state (#182/[P7b], fld_source_erad_from_gas below) so fld / fld+mrad are ACTIVE;
#      acond and mrad are now EOS-AWARE (#183/[P7c], acond_eos_aware / mrad_eos_aware below):
#      conduction recovers T from the tabulated electron closure and the grey coupling reads
#      c_v from the tabulated closure, consistent with tabulated_3t (not ideal-gamma).  The
#      coefficients are uncalibrated placeholders (a faithful SI calibration is #184/[P7d]).
# ---- SI calibration of the operator coefficients (#184/[P7d], ADR-0014, ADR-0012 gap d) ----
# When operators_si_calibrate is on (tabulated_3t only) the placeholder resb_eta, acond conv
# factors, mrad_chi_a and fld_chi below are REPLACED by values derived from first-principles
# Spitzer/Braginskii transport plus the IONMIX opacity at the reference state, converted into
# the <units> code system (the operator analogue of the ADR-0010 drive calibration).  Read
# only inside the operator blocks, so the operators-off baseline stays byte-identical; the
# per-operator attribution test overrides this OFF to pin the #181-183 facts with placeholders.
operators_si_calibrate    = true
si_calib_te_ev            = 100.0       # reference electron temperature, eV (Spitzer/Braginskii)
si_calib_zbar             = 6.65        # Al mean ionization Z at the ref node (al-imx-004, 100 eV)
si_calib_lnlam            = 5.0         # Coulomb logarithm at the reference state
si_calib_kappa_ross_cm2g  = 5358.0      # Al IONMIX Rosseland at the ref node, cm^2/g (sets fld_chi)
si_calib_kappa_planck_cm2g = 6968.0     # Al IONMIX Planck-absorption at the ref node, cm^2/g (mrad_chi_a)
strang_split         = false      # Strang-wrap the operator-split parabolic block (ADR-0009)
resb_operator_split  = false      # cylindrical resistive B_phi diffusion (issue 27)
resb_eta             = 1.0e-3     # placeholder diffusivity (superseded when calibrate on; SI #P7d)
resb_couple_b0       = true       # couple bphi <-> live driven b0.x2f (#181/[P7a], ADR-0012 gap a):
                                  #   resb now diffuses the DRIVING B_phi (active, not inert).  Read
                                  #   only when resb_operator_split is on => baseline byte-identical.
acond_operator_split = false      # anisotropic Braginskii conduction on the gas energy (issue 108)
acond_kappa_conv     = 0.05       # conduction coefficient (uncalibrated placeholder)
acond_eos_aware      = true       # recover conducted T from the tabulated_3t electron closure
                                  #   (T_e=Te(rho,e_ele/rho)) not ideal-gamma (#183/[P7c], gap c).
                                  #   Read only when acond_operator_split is on => byte-identical off.
fld_operator_split   = false      # grey flux-limited radiation diffusion (issue 110)
fld_source_erad_from_gas = true   # source erad from the gas state (#182/[P7b], ADR-0012 gap b):
                                  #   partition LTE a*T^4 out of the gas internal energy so the
                                  #   FLD field is physically fed and mrad has a real field to
                                  #   exchange against -> fld / fld+mrad now ACTIVE (not inert).
                                  #   Read only when fld_operator_split is on => byte-identical off.
fld_c_light          = 10.0       # code-unit radiation speed
fld_chi              = 1000.0     # grey opacity (opaque liner)
fld_n_larsen         = 2.0        # Larsen flux-limiter exponent
fld_e_source         = -1.0       # insulated (zero-gradient) radiation boundaries
mrad_coupling        = false      # point-implicit matter-radiation energy exchange (issue 23)
mrad_chi_a           = 0.04       # absorption opacity (matter-radiation coupling)
mrad_cv              = 1.5e-3     # constant heat capacity (EOS-inconsistent placeholder)
mrad_arad            = 1.0e-6     # radiation constant (code units)
mrad_clight          = 10.0       # coupling light speed (code units)
mrad_eos_aware       = true       # read c_v from the tabulated_3t closure (rho*(cv_e+cv_i)) not
                                  #   the constant mrad_cv (#183/[P7c], gap c).  Read only when
                                  #   mrad_coupling is on => baseline byte-identical.

<problem>
# ---- drive (ADR-0005 mode A): faithful z2173 tabulated load current ----
current_mode     = driven
current_waveform = tabulated        # prescribed I(t) replayed from the measured z2173 trace
current_file     = z2173_current.dat  # committed trace (tst/inputs); peak 20 MA, rise 100 ns
current_si       = true            # convert the trace from SI (ns, MA) to code units (ADR-0010)
mu0              = 1.0              # code-unit permeability (Heaviside-Lorentz)
# ---- AR6 Al liner target geometry, PHYSICAL CGS (normalised by <units>) ----
r_fuel           = 0.28875         # liner inner radius r_in 2.8875 mm (hollow-interior wall)
r_liner          = 0.34688         # liner outer radius r_out 3.4688 mm (liner/vacuum)
d_fuel           = 1.0e-3          # low-density interior fill (hollow tube; setup choice)
d_liner          = 2.7             # solid Al liner density 2.7 g/cc, maps to 1.0 code
d_vac            = 1.0e-4          # tenuous vacuum gap (r_out to R_out)
p0               = 1.0e-4          # cold thermal pressure (ideal-EOS fallback; unused if tabulated)
t_init_ev        = 1.0             # cold-LTE initial temperature [eV], clamped to the Al table floor
bz0              = 0.0             # no axial premagnetization for this single-mode run
# ---- seed: single axial sinusoid (Sinars single-mode MRT) ----
perturbation     = single_mode     # one axial mode on the liner interfaces
pert_amp         = 0.002           # radial seed amplitude 20 um (CGS cm; Sinars initial)
pert_mode        = 4               # axial mode number, lambda Lz/4 is 400 um
pert_phase       = 0.0             # axial phase offset
user_hist        = true            # conservation history: mass, etot, ...

<output1>
file_type   = bin
variable    = mhd_w_bcc
id          = prim
dt          = 3.0

<output2>
file_type      = hst
variable       = mhd
user_hist_only = true
dt             = 3.0
