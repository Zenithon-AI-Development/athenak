# AthenaK input: multi-mode magneto-Rayleigh-Taylor (MRT) on a driven liner (benchmark 2, #42).
#
# Reuses the integrated MagLIF/Z-pinch problem generator (-D PROBLEM=maglif, issue [10a]/#32) and
# the Phase-1 stack validated by benchmark 1 (single-mode MRT, #39).  A dense cylindrical liner is
# SUSTAINEDLY accelerated radially inward by a prescribed constant load current: the magnetic
# pressure of the enclosed B_phi field (the light fluid) pushes on the dense liner (the heavy
# fluid), the classic magneto-Rayleigh-Taylor (MRT) unstable configuration on the outer
# (liner/vacuum) interface.  Unlike benchmark 1's single seeded mode, the liner here carries a
# BAND of axial modes with deterministic random phases -- a manufactured SURFACE-ROUGHNESS
# spectrum.  Under the continuous inward acceleration the broadband roughness grows nonlinearly
# (the multi-mode MRT feed), and the radiographic observable is the growth of the broadband
# interface roughness / the modulation of a synthetic side-on radiograph.  This is FLASH MagLIF
# validation benchmark 2 (multi-mode MRT from surface roughness) from Ellison et al. 2025
# (arXiv:2504.10760).
#
# PHYSICS SCOPE (Phase B, #116/[B3], ADR-0009): this benchmark now runs the FULL COUPLED
# radiation-conduction-MHD stack -- cylindrical ideal-MHD (ADR-0004) + the prescribed-I(t)
# circuit drive (ADR-0005 mode A) + the Strang-split operator-split parabolic block (grey
# flux-limited radiation diffusion + anisotropic Braginskii conduction) with the
# point-implicit matter-radiation coupling outside the super-step (the <mhd> block below).
# Coefficients are nondimensional code units chosen so the coupled physics is a stable,
# signature-preserving perturbation; real opacity/EOS-derived values arrive with the IONMIX
# tables in Phase C (#118).  Resistive B_phi / multigroup FLD stay off here (Phase C).
#
# ADR-0004 fixes the axial direction to x3 and AthenaK forbids the (nx2=1, nx3>1) topology, so
# the axially-resolved run uses a thin azimuthal (phi) wedge -- the axisymmetric IC replicates
# the r-z state across phi.  Built with -D PROBLEM=maglif (a USER pgen, not in the suite binary).

<comment>
problem   = MagLIF multi-mode magneto-Rayleigh-Taylor (benchmark 2)

<job>
basename  = maglif_mmrt

<mesh>
nghost    = 2
nx1       = 64         # radial zones
x1min     = 0.0        # r = 0 axis
x1max     = 1.0        # outer radius R_out (driven boundary)
ix1_bc    = axis       # cylindrical r=0 axisymmetric boundary (issue #16)
ox1_bc    = user       # circuit-driven B_phi boundary (issue #21)

nx2       = 4          # thin azimuthal (phi) wedge (axisymmetric IC)
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 64         # axial (z) zones -- resolves the seeded band [2,6] (>=10 cells/wavelength)
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 64
nx2       = 4
nx3       = 64

<coord>
system    = cylindrical  # (x1,x2,x3) = (r,phi,z)

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 100000
tlim       = 0.4
ndiag      = 200

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = hlld
gamma       = 1.6666666666666667
dfloor      = 1.0e-5
pfloor      = 1.0e-7
# ---- full coupled radiation-conduction-MHD stack (#116/[B3], ADR-0009) ----
# See maglif_mrt.athinput for the rationale; identical nondimensional coefficients (same
# p0 = 1e-3 seeded state).  Strang-split grey-FLD + anisotropic conduction super-step with
# the point-implicit matter-radiation coupling outside it.  resb_*/mgfld_* off (Phase C).
strang_split          = true
fld_operator_split    = true
fld_c_light           = 10.0
fld_chi               = 1000.0 # opaque liner -> small radiative diffusivity D = c/(3 chi)
fld_n_larsen          = 2.0
fld_e_source          = -1.0
acond_operator_split  = true
acond_kappa_conv      = 0.05  # mild conduction: a signature-preserving thermal smoother
mrad_coupling         = true
mrad_chi_a            = 0.04  # gentle matter<->radiation coupling (modest perturbation)
mrad_cv               = 1.5e-3
mrad_arad             = 1.0e-6 # small radiation reservoir -> signature-preserving
mrad_clight           = 10.0

<problem>
current_mode     = driven       # driven (mu0*I/2*pi*r) B_phi outer boundary
current_waveform = constant     # prescribed I(t): constant load current -> SUSTAINED acceleration
i0               = 3.0          # load current (code units) -- strong enough for a clean implosion
t_rise           = 1.0          # ramp time (unused for the constant waveform)
mu0              = 1.0          # code-unit permeability (Heaviside-Lorentz: 1)
r_fuel           = 0.4          # fuel/liner interface radius
r_liner          = 0.6          # liner/vacuum interface (current sheet)
d_fuel           = 0.05         # fuel (inner gas) density
d_liner          = 1.0          # liner (dense shell) density
d_vac            = 0.01         # vacuum (outer gap) density
p0               = 1.0e-3       # uniform (low) thermal pressure
bz0              = 0.1          # axial premagnetization field B_z
perturbation     = roughness    # band of axial modes (surface-roughness spectrum)
pert_amp         = 0.08         # aggregate radial roughness amplitude (split per mode)
pert_nmin        = 2            # lowest seeded axial mode number
pert_nmax        = 6            # highest seeded axial mode number (wavelength = Lz/n)
pert_seed        = 12345        # RNG seed -> deterministic mode phases (reproducible)
user_hist        = true         # conservation history: mass, etot, ..., erad (coupled stack)

<output1>
file_type   = bin
variable    = mhd_w_bcc
id          = prim
dt          = 0.02

<output2>
file_type      = hst   # conservation history -> maglif_mmrt.user.hst (etot + erad budget)
variable       = mhd
user_hist_only = true
dt             = 0.02
