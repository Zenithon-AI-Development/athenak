# AthenaK input: PAPER-RESOLUTION multi-mode magneto-Rayleigh-Taylor on a driven liner --
# Ellison benchmark 2 / [C5] (issue #122), the QUALITATIVE GPU replication.
#
# Reuses the integrated MagLIF/Z-pinch problem generator (-D PROBLEM=maglif, issue [10a]/#32):
# a dense cylindrical (Be-like) liner is SUSTAINEDLY accelerated radially inward by a prescribed
# constant load current.  The magnetic pressure of the enclosed B_phi field (the light fluid)
# pushes on the dense liner (the heavy fluid) -- the classic magneto-Rayleigh-Taylor (MRT)
# unstable configuration on the outer (liner/vacuum) interface.  The liner carries a BAND of
# axial modes with deterministic random phases -- a manufactured SURFACE-ROUGHNESS spectrum
# (the experimental Be-liner machining/roughness seed).  Under the continuous inward
# acceleration the broadband roughness grows nonlinearly (the multi-mode MRT feed); the
# radiographic observable is the growth of the broadband interface roughness / the modulation
# of a synthetic side-on radiograph.  This is FLASH MagLIF validation benchmark 2 (multi-mode
# MRT from surface roughness) from Ellison et al. 2025 (arXiv:2504.10760).
#
# VALIDATION TIER (#122 [C5]): QUALITATIVE.  Per the tiered validation bar, multi-mode MRT from
# surface roughness is INHERENTLY STOCHASTIC (the seed phases are not the experiment's, and the
# nonlinear cascade is chaotic), so the benchmark is validated QUALITATIVELY -- the synthetic
# radiograph reproduces the qualitative LIMB-MODULATION behaviour (a broadband, multi-mode,
# driven-surface-dominant roughening that grows under sustained acceleration) -- WITHOUT
# overclaiming a quantitative match to a digitized curve.  The quantitative McBride-2012 growth
# CURVE stays the reduced-_cpu reported anchor (test_verify_maglif_mmrt_cpu.py, #143).
#
# PHYSICS SCOPE: the multi-mode MRT feed is a magneto-HYDRODYNAMIC instability, set by the
# inward acceleration (magnetic pressure) and the Atwood number across the liner/vacuum
# interface -- carried by the cylindrical ideal-MHD core (ADR-0004) + the prescribed-I(t)
# circuit drive (ADR-0005 mode A).  The coupled radiation-conduction stack (ADR-0009) is OFF
# here for the same PHYSICS reason as benchmark 3 (maglif_rm_si.athinput): the nondimensional
# TOY coefficients would non-physically DAMP the MRT growth being measured (anisotropic
# conduction stabilises the mode, #116/[B3]).  (The operator-split parabolic GPU path that used
# to segfault at runtime on the first super-step was fixed in #153/#139 and now runs on GPU;
# the coupled GPU path is regression-guarded by test_verify_maglif_smoke_gpu.py.)  The coupled
# stack is validated separately on CPU (#115/#116/#117) and on GPU (smoke #139), and the
# COUPLED multi-mode run is the _cpu benchmark (test_verify_maglif_mmrt_cpu.py).
#
# RESOLUTION NOTE: AthenaK does not support 3-D cylindrical SMR/AMR (only the 2-D (r,phi)
# Balsara B-prolongation exists, issue #38).  The MRT seed is AXIAL (kz band [2,6] along z), so
# z must be resolved -> a 3-D (r,phi,z) mesh, hence AMR is unavailable for this geometry.
# "Paper resolution" is therefore a UNIFORM fine grid: nx1=512 radial (dr ~ 2e-3, ~8 cells per
# per-mode seed amplitude) x nx3=128 axial (>=21 cells / shortest seeded wavelength Lz/6).
# Multi-block (8 root MeshBlocks) exercises the multi-block boundary sync on GPU.
#
# ADR-0004 fixes the axial direction to x3; AthenaK forbids (nx2=1, nx3>1), so the axially-
# resolved run uses a thin azimuthal (phi) wedge -- the axisymmetric IC replicates the r-z state
# across phi.  Built with -D PROBLEM=maglif (a USER pgen).  GPU run (athenakdev / A100).

<comment>
problem   = MagLIF multi-mode MRT, paper-resolution GPU qualitative replication (benchmark 2)

<job>
basename  = maglif_mmrt_si

<mesh>
nghost    = 2
nx1       = 512        # radial zones (uniform paper-resolution); dr ~ 2e-3
x1min     = 0.0        # r = 0 axis
x1max     = 1.0        # outer radius R_out (driven boundary)
ix1_bc    = axis       # cylindrical r=0 axisymmetric boundary (issue #16)
ox1_bc    = user       # circuit-driven B_phi boundary (issue #21)

nx2       = 4          # thin azimuthal (phi) wedge (axisymmetric IC)
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 128        # axial (z) zones -- resolves the seeded band [2,6] (>=21 cells/wavelength)
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 128        # 512/128 = 4 root MeshBlocks along r
nx2       = 4
nx3       = 64         # 128/64 = 2 root MeshBlocks along z (8 blocks total)

<coord>
system    = cylindrical  # (x1,x2,x3) = (r,phi,z)

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 400000
tlim       = 0.4
ndiag      = 500

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = hlld
gamma       = 1.6666666666666667
dfloor      = 1.0e-5
pfloor      = 1.0e-7
# ---- coupled radiation-conduction stack OFF for the GPU qualitative MRT replication ----
# The multi-mode MRT feed is magneto-hydrodynamic; the toy-coefficient coupled stack would
# suppress it, and the operator-split parabolic GPU path segfaults at runtime (#139).  GPU runs
# are ideal-MHD only; the COUPLED multi-mode run is the _cpu benchmark.  Left here (defaulted
# off) to document the wiring.
strang_split          = false
fld_operator_split    = false
acond_operator_split  = false
mrad_coupling         = false

<problem>
current_mode     = driven       # driven (mu0*I/2*pi*r) B_phi outer boundary
current_waveform = constant     # prescribed I(t): constant load current -> SUSTAINED acceleration
i0               = 3.0          # load current (code units) -- strong enough for a clean implosion
t_rise           = 1.0          # ramp time (unused for the constant waveform)
mu0              = 1.0          # code-unit permeability (Heaviside-Lorentz: 1)
r_fuel           = 0.4          # fuel/liner interface radius
r_liner          = 0.6          # liner/vacuum interface (current sheet)
d_fuel           = 0.05         # fuel (inner gas) density
d_liner          = 1.0          # liner (dense shell) density
d_vac            = 0.01         # vacuum (outer gap) density
p0               = 1.0e-3       # uniform (low) thermal pressure
bz0              = 0.1          # axial premagnetization field B_z
perturbation     = roughness    # band of axial modes (surface-roughness spectrum)
pert_amp         = 0.08         # aggregate radial roughness amplitude (split per mode)
pert_nmin        = 2            # lowest seeded axial mode number
pert_nmax        = 6            # highest seeded axial mode number (wavelength = Lz/n)
pert_seed        = 12345        # RNG seed -> deterministic mode phases (reproducible)
user_hist        = true         # conservation history: mass, etot, ...

<output1>
file_type   = bin
variable    = mhd_w_bcc
id          = prim
dt          = 0.02

<output2>
file_type      = hst
variable       = mhd
user_hist_only = true
dt             = 0.02
